{
  "name": "@ochairo/scales",
  "version": "1.6.6",
  "description": "Framework-agnostic scale functions for data visualization",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && pnpm build:minify",
    "build:minify": "esbuild dist/index.js dist/linear.js dist/band.js dist/time.js dist/types.js dist/log.js dist/pow.js dist/ordinal.js --outdir=dist --format=esm --allow-overwrite --minify --legal-comments=none --tree-shaking=true",
    "validate": "pnpm test && pnpm typecheck && pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist",
    "size": "ls -lh dist/*.js | awk '{print $9, $5}'"
  },
  "keywords": [
    "scales",
    "data-visualization",
    "charts",
    "mapping",
    "ochairo"
  ],
  "author": "ochairo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ochairo/scales"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.27.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
